ORS_API_KEY=
# Identify the prototype when using the public Nominatim and Valhalla demos.
NAVI_USER_AGENT="NAVI-Prototype/0.1 (single-device development)"
PORT=8787
# USB debugging: adb reverse tcp:8787 tcp:8787
EXPO_PUBLIC_NAVI_PROXY_URL=http://127.0.0.1:8787
